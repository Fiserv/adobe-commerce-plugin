<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Fiserv Magento Coding Standard" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Magento Coding Standard for Fiserv Payments Plugin - Aligned with Adobe EQP</description>

    <!-- Scan these files and directories -->
    <file>Api/</file>
    <file>Block/</file>
    <file>Controller/</file>
    <file>Gateway/</file>
    <file>Helper/</file>
    <file>Lib/</file>
    <file>Logger/</file>
    <file>Model/</file>
    <file>Observer/</file>
    <file>registration.php</file>

    <!-- Exclude generated and vendor code -->
    <exclude-pattern>*/generated/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>

    <!-- Use Magento2 Coding Standard from vendor if available -->
    <rule ref="vendor/magento/magento-coding-standard/Magento2/ruleset.xml">
        <!-- Ignore annotations as per EQP requirements -->
        <exclude name="Magento2.Annotation"/>
    </rule>

    <!-- File extensions to check -->
    <arg name="extensions" value="php,phtml"/>

    <!-- Show progress and use colors -->
    <arg value="p"/>
    <arg name="colors"/>

    <!-- Set error severity to 10 (blocks publication) as per EQP -->
    <arg name="error-severity" value="10"/>
    
    <!-- Ignore annotations flag as per EQP -->
    <arg name="ignore-annotations"/>

    <!-- Parallel processing for speed -->
    <arg name="parallel" value="8"/>

    <!-- Show sniff codes in all reports -->
    <arg value="ns"/>
</ruleset>
