<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<table name="valuelink_transaction" resource="default" engine="innodb" comment="Transcation Processed through Valuelink">
		<column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" />
		<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="entity_id" />
		</constraint>

		<column name="parent_transaction_id" xsi:type="int" unsigned="true" nullable="true" identity="false" />
		<constraint xsi:type="foreign" referenceId="FK_VALUELINK_TRANSACTION_PARENT_TRANSACTION" table="valuelink_transaction" column="parent_transaction_id" referenceTable="valuelink_transaction" referenceColumn="entity_id" onDelete="CASCADE" />

		<column name="order_id" xsi:type="int" unsigned="true" nullable="true" identity="false" />
		<constraint xsi:type="foreign" referenceId="FK_VALUELINK_TRANSACTION_ORDER_ID" table="valuelink_transaction" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE" />

		<column name="invoice_id" xsi:type="int" unsigned="true" nullable="true" identity="false" />
		<constraint xsi:type="foreign" referenceId="FK_VALUELINK_TRANSACTION_INVOICE_ID" table="valuelink_transaction" column="invoice_id" referenceTable="sales_invoice" referenceColumn="entity_id" onDelete="CASCADE" />

		<column name="creditmemo_id" xsi:type="int" unsigned="true" nullable="true" identity="false" />
		<constraint xsi:type="foreign" referenceId="FK_VALUELINK_TRANSACTION_CREDITMEMO_ID" table="valuelink_transaction" column="creditmemo_id" referenceTable="sales_creditmemo" referenceColumn="entity_id" onDelete="CASCADE" />

		<column xsi:type="varchar" name="order_increment_id" nullable="false" length="50"/>
		<column xsi:type="varchar" name="transaction_id" nullable="true" length="255" comment="Commerce Hub Transaction Id"/>
		<column xsi:type="varchar" name="transaction_type" nullable="true" length="255" comment="Commerce Hub Transaction Type"/>
		<column xsi:type="varchar" name="transaction_state" nullable="true" length="255" comment="Commerce Hub Transaction State"/>
		<column xsi:type="text" name="ch_request" nullable="true" comment="Full Commerce Hub Request"/>
		<column xsi:type="text" name="ch_response" nullable="true" comment="Full Commerce Hub Response"/>
		<column xsi:type="decimal" name="amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Valuelink Transaction Amount"/>        
		<column xsi:type="varchar" name="currency" nullable="true" length="255" comment="Valuelink Transaction Currency"/>
		<column xsi:type="date" name="date_created" nullable="false" comment="Date Created"/>
	</table>

	<table name="fiserv_paypal_customer" resource="default">
		<column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
		<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="entity_id"/>
		</constraint>
		<column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
		<constraint xsi:type="foreign" referenceId="FK_FISERV_PAYPAL_CUSTOMER_CUSTOMER_ID" table="fiserv_paypal_customer" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
		<column xsi:type="varchar" name="paypal_provider_customer_id" nullable="false" length="255" comment="PayPal Provider Customer ID"/>
	</table>

	<table name="quote" resource="checkout" comment="Sales Flat Quote">
		<column xsi:type="text" name="valuelink_cards" nullable="true" comment="Valuelink Cards"/>
		<column xsi:type="decimal" name="valuelink_cards_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Valuelink Amount"/>
		<column xsi:type="decimal" name="base_valuelink_cards_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Base Valuelink Cards Amount"/>
	</table>

	<table name="quote_address" resource="checkout" comment="Sales Flat Quote Address">
		<column xsi:type="decimal" name="valuelink_cards_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Valuelink Cards Amount"/>
		<column xsi:type="decimal" name="base_valuelink_cards_amount" scale="4" precision="20" unsigned="false" nullable="true" comment="Base Valuelink Cards Amount"/>
		<column xsi:type="text" name="valuelink_cards" nullable="true" comment="Valuelink Cards"/>
	</table>

	<!-- Simplified Table for Logging Failed Transactions -->
	<table name="failed_transaction" resource="default" engine="innodb" comment="Failed Transactions">
		<column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
		<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="entity_id"/>
		</constraint>
		<column xsi:type="varchar" name="order_increment_id" nullable="true" length="255" comment="Commerce Hub Transaction Id"/>
		<column xsi:type="timestamp" name="date_time" nullable="false" default="CURRENT_TIMESTAMP" comment="Date and Time"/>
		<column xsi:type="varchar" name="transaction_state" nullable="true" length="50" comment="Transaction State"/>
		<column xsi:type="varchar" name="approval_status" nullable="true" length="50" comment="Approval Status"/>
		<column xsi:type="decimal" name="total_amount" scale="2" precision="10" nullable="false" comment="Total Amount"/>
		<column xsi:type="varchar" name="processor" nullable="true" length="255" comment="Processor"/>
		<column xsi:type="varchar" name="host" nullable="true" length="255" comment="Host"/>
		<column xsi:type="varchar" name="merchant_id" nullable="true" length="255" comment="Merchant ID"/>
		<column xsi:type="varchar" name="expiration_month" nullable="true" length="2" comment="Expiration Month"/>
		<column xsi:type="varchar" name="expiration_year" nullable="true" length="4" comment="Expiration Year"/>
		<column xsi:type="varchar" name="last4" nullable="true" length="4" comment="Last 4 Digits"/>
		<column xsi:type="varchar" name="scheme" nullable="true" length="255" comment="Scheme"/>
		<column xsi:type="varchar" name="bin" nullable="true" length="255" comment="bin"/>
		<column xsi:type="varchar" name="network_response_code" nullable="true" length="32" comment="Network Response Code"/>
		<column xsi:type="varchar" name="host_response_message" nullable="true" length="32" comment="Host Response Message"/>
		<column xsi:type="varchar" name="retrieval_reference_number" nullable="true" length="50" comment="Retrieval Reference Number"/>
		<column xsi:type="varchar" name="transaction_id" nullable="true" length="255" comment="Transaction ID"/>
		<column xsi:type="varchar" name="currency" nullable="true" length="10" comment="Currency"/>
		<column xsi:type="varchar" name="bank_association_details" nullable="true" length="255" comment="Bank Association Details"/>
		<column xsi:type="varchar" name="remote_ip" nullable="true" length="45" comment="Remote IP Address"/>
		<column xsi:type="varchar" name="country" nullable="true" length="50" comment="Country"/>
		<column xsi:type="varchar" name="api_trace_id" nullable="true" length="255" comment="API Trace ID"/>
		<column xsi:type="varchar" name="responseCode" nullable="true" length="255" comment="Response Code"/>
		<column xsi:type="varchar" name="responseMessage" nullable="true" length="255" comment="Response Message"/>
		<column xsi:type="varchar" name="merchantAdviceCode" nullable="true" length="255" comment="Merchant Advice Code"/>
		<column xsi:type="varchar" name="securityCodeMatch" nullable="true" length="255" comment="Security Code Match"/>
		<column xsi:type="varchar" name="paymentAction" nullable="true" length="255" comment="Payment Action"/>


	</table>

	<!-- Simplified Table for Logging Failed Orders -->
	<table name="failed_order" resource="default" engine="innodb" comment="Failed Order">
		<column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
		<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="entity_id"/>
		</constraint>
		<column xsi:type="varchar" name="order_increment_id" nullable="false" length="255" comment="Order Increment Id"/>
		<column xsi:type="timestamp" name="date_time" nullable="false" default="CURRENT_TIMESTAMP" comment="Date and Time"/>
		<column xsi:type="varchar" name="order_state" nullable="false" length="50" comment="Order State"/>
		<column xsi:type="varchar" name="billing_address" nullable="false" length="1000" comment="Billing Address"/>
		<column xsi:type="varchar" name="shipping_address" nullable="false" length="1000" comment="Shipping Address"/>
		<column xsi:type="varchar" name="customer_name" nullable="false" length="255" comment="Customer Name"/>
		<column xsi:type="varchar" name="customer_email" nullable="true" length="255" comment="Customer Email"/>
		<column xsi:type="decimal" name="subtotal" scale="4" precision="20" unsigned="false" nullable="false" comment="Subtotal"/>        
		<column xsi:type="decimal" name="shipping_handling" scale="4" precision="20" unsigned="false" nullable="false" comment="Shipping and Handling"/>        
		<column xsi:type="decimal" name="grandTotal" scale="4" precision="20" unsigned="false" nullable="false" comment="Grand Total"/>        
		<column xsi:type="varchar" name="notes" nullable="true" length="1000" comment="Order Notes"/>
		<column xsi:type="text" name="items" nullable="false" comment="Items"/>
		<column xsi:type="decimal" name="storeCredit" scale="4" precision="20" unsigned="false" nullable="false" comment="Store Credit"/>
		<column xsi:type="decimal" name="discountAmount" scale="4" precision="20" unsigned="false" nullable="false" comment="Discount Amount"/>
	</table>

        <!-- Table for tracking pending transaction inquiry jobs -->
        <table name="fiserv_pending_inquiry_job" resource="default" engine="innodb" comment="Pending Transaction Inquiry Jobs">
                <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
                <constraint xsi:type="primary" referenceId="PRIMARY">
                        <column name="entity_id"/>
                </constraint>
                <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Magento Order Entity ID"/>
                <column xsi:type="varchar" name="order_increment_id" nullable="false" length="50" comment="Magento Order Increment ID"/>
                <column xsi:type="varchar" name="reference_order_id" nullable="false" length="255" comment="CommerceHub Reference Order ID (CHG01...)"/>
                <column xsi:type="varchar" name="payment_method" nullable="false" length="50" comment="Payment Method Code"/>
                <column xsi:type="varchar" name="status" nullable="false" length="20" default="queued" comment="Job Status: queued, processing, completed, failed"/>
                <column xsi:type="varchar" name="transaction_state" nullable="true" length="50" comment="Last Known Transaction State"/>
                <column xsi:type="varchar" name="approval_status" nullable="true" length="50" comment="Last Known Approval Status"/>
                <column xsi:type="int" name="attempts" unsigned="true" nullable="false" default="0" comment="Number of inquiry attempts"/>
                <column xsi:type="int" name="max_attempts" unsigned="true" nullable="false" default="5" comment="Maximum inquiry attempts"/>
                <column xsi:type="timestamp" name="next_run_at" nullable="false" comment="Next scheduled run time"/>
                <column xsi:type="text" name="last_response" nullable="true" comment="Last inquiry response JSON"/>
                <column xsi:type="text" name="error_message" nullable="true" comment="Last error message if any"/>
                <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
                <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
                <index referenceId="IDX_FISERV_PENDING_INQUIRY_JOB_STATUS" indexType="btree">
                        <column name="status"/>
                </index>
                <index referenceId="IDX_FISERV_PENDING_INQUIRY_JOB_NEXT_RUN" indexType="btree">
                        <column name="next_run_at"/>
                </index>
                <index referenceId="IDX_FISERV_PENDING_INQUIRY_JOB_ORDER_INCREMENT" indexType="btree">
                        <column name="order_increment_id"/>
                </index>
        </table>

    <table name="fiserv_open_refund" resource="default" engine="innodb" comment="Standalone Open Refund Records">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Primary Key"/>
        <column xsi:type="decimal" name="amount" scale="2" precision="12" unsigned="false" nullable="false" comment="Refund Amount"/>
        <column xsi:type="varchar" name="currency_code" nullable="false" length="10" default="USD" comment="Currency Code"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID (FK to customer_entity, SET NULL on delete)"/>
        <column xsi:type="varchar" name="customer_email" nullable="true" length="255" comment="Customer Email (snapshotted at submission)"/>
        <column xsi:type="varchar" name="customer_name" nullable="true" length="255" comment="Customer Full Name (snapshotted at submission)"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="true" comment="Admin User ID (populated server-side)"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="pending" comment="Record Status: pending / success / failed"/>
        <column xsi:type="varchar" name="transaction_id" nullable="true" length="255" comment="CommerceHub Transaction ID"/>
        <column xsi:type="varchar" name="masked_card" nullable="true" length="20" comment="Last 4 digits from CommerceHub response"/>
        <column xsi:type="varchar" name="reference_transaction_id" nullable="true" length="255" comment="Optional prior transaction ID for audit trail"/>
        <column xsi:type="text" name="notes" nullable="true" comment="Free-text admin notes"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="IDX_FISERV_OPEN_REFUND_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="IDX_FISERV_OPEN_REFUND_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="IDX_FISERV_OPEN_REFUND_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
