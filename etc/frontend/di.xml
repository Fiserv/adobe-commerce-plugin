<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<type name="Magento\Checkout\Model\CompositeConfigProvider">
		<arguments>
			<argument name="configProviders" xsi:type="array">
				<item name="fiserv_payments_config_provider" xsi:type="object">Fiserv\Payments\Model\Config\ConfigProvider</item>
				<item name="fiserv_commercehub_config_provider" xsi:type="object">Fiserv\Payments\Model\Config\CommerceHub\ConfigProvider</item>
				<item name="fiserv_paypal" xsi:type="object">Fiserv\Payments\Model\Config\PayPal\ConfigProvider</item>
				<item name="fiserv_paypal_fastlane" xsi:type="object">Fiserv\Payments\Model\Config\PayPal\Fastlane\ConfigProvider</item>
                <item name="fiserv_applepay" xsi:type="object">Fiserv\Payments\Model\Config\ApplePay\ConfigProvider</item>
                <item name="fiserv_venmo" xsi:type="object">Fiserv\Payments\Model\Config\Venmo\ConfigProvider</item>
				<item name="fiserv_affirm" xsi:type="object">Fiserv\Payments\Model\Config\Affirm\ConfigProvider</item>
				<item name="fiserv_samsung_pay" xsi:type="object">Fiserv\Payments\Model\Config\SamsungPay\ConfigProvider</item>
				<item name="fiserv_ach" xsi:type="object">Fiserv\Payments\Model\Config\Ach\ConfigProvider</item>
				<item name="fiserv_paze" xsi:type="object">Fiserv\Payments\Model\Config\Paze\ConfigProvider</item>
			<item name="fiserv_googlepay" xsi:type="object">Fiserv\Payments\Model\Config\GooglePay\ConfigProvider</item>
            </argument>
		</arguments>
	</type>
	<type name="Magento\Payment\Model\CcGenericConfigProvider">
		<arguments>
			<argument name="methodCodes" xsi:type="array">
				<item name="fiserv_commercehub" xsi:type="const">Fiserv\Payments\Model\Config\CommerceHub\ConfigProvider::CODE</item>
			</argument>
		</arguments>
	</type>
	<type name="Magento\Vault\Model\Ui\TokensConfigProvider">
		<arguments>
			<argument name="tokenUiComponentProviders" xsi:type="array">
				<item name="fiserv_commercehub" xsi:type="object">Fiserv\Payments\Model\Ui\CommerceHub\TokenUiComponentProvider</item>
			</argument>
		</arguments>
	</type>
</config>
