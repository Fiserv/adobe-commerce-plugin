<?xml version="1.0" ?>
<payment xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Payment:etc/payment.xsd">
	<groups>
		<group id="fiserv_group">
			<label>Fiserv Payments</label>
		</group>
	</groups>
	<methods>
		<method name="fiserv_commercehub">
			<allow_multiple_address>0</allow_multiple_address>
		</method>
		<method name="fiserv_paypal">
			<allow_multiple_address>0</allow_multiple_address>
		</method>
		<method name="fiserv_paypal_fastlane">
			<allow_multiple_address>0</allow_multiple_address>
		</method>
        <method name="fiserv_applepay">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
        <method name="fiserv_venmo">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
		<method name="fiserv_affirm">
			<allow_multiple_address>0</allow_multiple_address>
		</method>
		<method name="fiserv_samsung_pay">
			<allow_multiple_address>0</allow_multiple_address>
		</method>
		<method name="fiserv_ach">
			<allow_multiple_address>0</allow_multiple_address>
		</method>
		<method name="fiserv_paze">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
    </methods>
</payment>
