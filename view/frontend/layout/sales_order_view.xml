<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<body>
		<referenceBlock name="order_totals">
			<block class="Fiserv\Payments\Block\Valuelink\Sales\Order\ValuelinkCards"
				   name="valuelink_cards"
				   template="Fiserv_Payments::valuelink/order/valuelink_cards.phtml"
				   cacheable="false"/>
		</referenceBlock>

		<referenceContainer name="content">
			<block class="Fiserv\Payments\Block\Subscription\Recurring"
				   name="valuelink_recurring_details_content"
				   template="Fiserv_Payments::subscription/recurring.phtml"
				   cacheable="false"/>
		</referenceContainer>
	</body>
</page>
