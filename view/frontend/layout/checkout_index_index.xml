<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	   <head>
<css src="Fiserv_Payments::css/ch-form.css"/>
<css src="Fiserv_Payments::css/paypal-styles.css"/>
           <css src="Fiserv_Payments::css/applepay-styles.css"/>
	   <css src="Fiserv_Payments::css/affirm-styles.css"/>
	   <css src="Fiserv_Payments::css/paze-styles.css"/>
	   <css src="Fiserv_Payments::css/googlepay-styles.css"/>

<css src="Fiserv_Payments::css/fastlane-styles.css"/>
<link src="Fiserv_Payments::js/view/payment/fastlane-script.js" />
	   </head>
	   <body>
		<referenceBlock name="checkout.root">
			<arguments>
				<argument name="jsLayout" xsi:type="array">
					<item name="components" xsi:type="array">
						<item name="checkout" xsi:type="array">
							<item name="children" xsi:type="array">
								<item name="steps" xsi:type="array">
									<item name="children" xsi:type="array">
										<item name="billing-step" xsi:type="array">
											<item name="component" xsi:type="string">uiComponent</item>
											<item name="children" xsi:type="array">
												<item name="payment" xsi:type="array">
													<item name="children" xsi:type="array">
														<item name="renders" xsi:type="array">
															<!-- merge payment method renders here -->
															<item name="children" xsi:type="array">
																<item name="fiserv_payments" xsi:type="array">
																	<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_payments</item>
																	<item name="methods" xsi:type="array">
																		<item name="fiserv_commercehub" xsi:type="array">
																			<item name="isBillingAddressRequired" xsi:type="boolean">true</item>
																		</item>
																		<item name="fiserv_commercehub_vault" xsi:type="array">
																			<item name="isBillingAddressRequired" xsi:type="boolean">true</item>
																		</item>
																	</item>
																</item>
																<item name="fiserv_paypal" xsi:type="array">
																	<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_paypal</item>
																	<item name="methods" xsi:type="array">
																		<item name="fiserv_paypal" xsi:type="array">
																			<item name="isBillingAddressRequired" xsi:type="boolean">true</item>
																		</item>
																	</item>
																</item>
                                                                <item name="fiserv_venmo" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_venmo</item>
                                                                    <item name="methods" xsi:type="array">
                                                                        <item name="fiserv_venmo" xsi:type="array">
                                                                            <item name="isBillingAddressRequired" xsi:type="boolean">true</item>
                                                                        </item>
                                                                    </item>
                                                                </item>
                                                                <item name="fiserv_paypal_fastlane" xsi:type="array">
																	<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_paypal_fastlane</item>
																	<item name="methods" xsi:type="array">
																		<item name="fiserv_paypal_fastlane" xsi:type="array">
																			<item name="isBillingAddressRequired" xsi:type="boolean">true</item>
																		</item>
																	</item>
																</item>
                                                                <item name="fiserv_applepay" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_applepay</item>
                                                                    <item name="methods" xsi:type="array">
                                                                        <item name="fiserv_applepay" xsi:type="array">
                                                                            <item name="isBillingAddressRequired" xsi:type="boolean">true</item>
                                                                        </item>
                                                                    </item>
                                                                </item>
																<item name="fiserv_affirm" xsi:type="array">
																	<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_affirm</item>
																	<item name="methods" xsi:type="array">
																		<item name="fiserv_affirm" xsi:type="array">
																			<item name="isBillingAddressRequired" xsi:type="boolean">true</item>
																		</item>
																	</item>
																</item>
																<item name="fiserv_samsung_pay" xsi:type="array">
																	<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_samsung_pay</item>
																	<item name="methods" xsi:type="array">
																		<item name="fiserv_samsung_pay" xsi:type="array">
																			<item name="isBillingAddressRequired" xsi:type="boolean">true</item>
																		</item>
																	</item>
																</item>
																<item name="fiserv_ach" xsi:type="array">
																	<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_ach</item>
																	<item name="methods" xsi:type="array">
																		<item name="fiserv_ach" xsi:type="array">
																			<item name="isBillingAddressRequired" xsi:type="boolean">true</item>
																		</item>
																	</item>
																</item>
                                                                <item name="fiserv_paze" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_paze</item>
                                                                    <item name="methods" xsi:type="array">
                                                                        <item name="fiserv_paze" xsi:type="array">
                                                                            <item name="isBillingAddressRequired" xsi:type="boolean">true</item>
                                                                        </item>
                                                                    </item>
                                                                </item>
                                                                <item name="fiserv_googlepay" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/fiserv_googlepay</item>
                                                                    <item name="methods" xsi:type="array">
                                                                        <item name="fiserv_googlepay" xsi:type="array">
                                                                            <item name="isBillingAddressRequired" xsi:type="boolean">true</item>
                                                                        </item>
                                                                    </item>
                                                                </item>
														</item>
														</item>
														<item name="afterMethods" xsi:type="array">
															<item name="children" xsi:type="array">
																<item name="valuelink" xsi:type="array">
																	<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/valuelink</item>
																	<item name="children" xsi:type="array">
																		<item name="errors" xsi:type="array">
																			<item name="sortOrder" xsi:type="string">0</item>
																			<item name="component" xsi:type="string">Fiserv_Payments/js/view/payment/valuelink_messages</item>
																			<item name="displayArea" xsi:type="string">messages</item>
																		</item>
																	</item>
																</item>
															</item>
														</item>
													</item>
												</item>
											</item>
										</item>
									</item>
								</item>
								<item name="sidebar" xsi:type="array">
									<item name="children" xsi:type="array">
										<item name="summary" xsi:type="array">
											<item name="children" xsi:type="array">
												<item name="totals" xsi:type="array">
													<item name="children" xsi:type="array">
														<item name="fiserv_valuelink" xsi:type="array">
															<item name="component" xsi:type="string">Fiserv_Payments/js/view/valuelink/summary/valuelink-gift-card</item>
															<item name="sortOrder" xsi:type="string">31</item>
															<item name="config" xsi:type="array">
																<item name="title" translate="true" xsi:type="string">Gift Card</item>
															</item>
														</item>
													</item>
												</item>
											</item>
										</item>
									</item>
								</item>
							</item>
						</item>
					</item>
				</argument>
			</arguments>
		</referenceBlock>
	</body>
</page>
