<?php
/**
 * @var \Fiserv\Payments\Block\Subscription\Recurring $block
 */

// Always define $vaultListUrl first — it is referenced in the JS block at the bottom of this
// file and must be set even on the order-view path which does an early return before line 85.
$vaultListUrl = $block->getUrl('fiserv/subscription/getVaultTokens');

$rows        = $block->getPriorRecurringPayments();
$vaultTokens = (array)$block->getVaultTokens();
$isOrderViewPage = $block->getRequest()->getFullActionName() === 'sales_order_view';

if ($isOrderViewPage):
    $singleData = $block->getSingleOrderViewData();
?>
    <div class="block block-order-details-view">
        <div class="block-title"><strong><?= $block->escapeHtml(__('Recurring Payment Details')) ?></strong></div>
        <div class="block-content">
            <?php if ($singleData === null): ?>
                <p><?= $block->escapeHtml(__('No recurring payment data found for this order.')) ?></p>
            <?php else: ?>
                <table style="width:100%; border-collapse:collapse; font-size:14px;">
                    <thead>
                        <tr style="background:#f5f5f5;">
                            <th style="text-align:left; padding:8px; border-bottom:2px solid #ddd;"><?= $block->escapeHtml(__('Order')) ?></th>
                            <th style="text-align:left; padding:8px; border-bottom:2px solid #ddd;"><?= $block->escapeHtml(__('Date')) ?></th>
                            <th style="text-align:left; padding:8px; border-bottom:2px solid #ddd;"><?= $block->escapeHtml(__('Amount')) ?></th>
                            <th style="text-align:left; padding:8px; border-bottom:2px solid #ddd;"><?= $block->escapeHtml(__('Transaction ID')) ?></th>
                            <th style="text-align:left; padding:8px; border-bottom:2px solid #ddd;"><?= $block->escapeHtml(__('Payment Method')) ?></th>
                            <th style="text-align:left; padding:8px; border-bottom:2px solid #ddd;"><?= $block->escapeHtml(__('Status')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding:8px; border-bottom:1px solid #eee;">
                                <?= $block->escapeHtml($singleData['increment_id']) ?>
                            </td>
                            <td style="padding:8px; border-bottom:1px solid #eee;">
                                <?= $block->escapeHtml($singleData['date']) ?>
                            </td>
                            <td style="padding:8px; border-bottom:1px solid #eee;">
                                <?= $block->escapeHtml($singleData['amount']) ?>
                            </td>
                            <td style="padding:8px; border-bottom:1px solid #eee;">
                                <?php if ($singleData['transaction_id'] !== ''): ?>
                                    <code><?= $block->escapeHtml($singleData['transaction_id']) ?></code>
                                <?php else: ?>
                                    <span style="color:#999;"><?= $block->escapeHtml(__('N/A')) ?></span>
                                <?php endif; ?>
                            </td>
                            <td style="padding:8px; border-bottom:1px solid #eee;">
                                <?php if ($singleData['card_label'] !== ''): ?>
                                    <?= $block->escapeHtml(__('Card used: %1', $singleData['card_label'])) ?>
                                <?php else: ?>
                                    <span style="color:#999;"><?= $block->escapeHtml(__('—')) ?></span>
                                <?php endif; ?>
                            </td>
                            <td style="padding:8px; border-bottom:1px solid #eee;">
                                <?php
                                $statusDisplay = ucfirst((string)$singleData['status']);
                                $statusColor   = $block->getStatusColor((string)$singleData['status']);
                                ?>
                                <span style="color:<?= $block->escapeHtmlAttr($statusColor) ?>; font-weight:600;">
                                    <?= $block->escapeHtml($statusDisplay) ?>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            <?php endif; ?>
        </div>
    </div>
<?php return; endif; ?>

<?php
// Build a filtered list of tokens that have a non-empty public_hash.
$validVaultTokens = array_filter(
    $vaultTokens,
    fn($tok) => $block->getTokenPublicHash($tok) !== ''
);

// Build inline snapshot for JS (array of {public_hash,label})
$initialVaultTokens = array_values(array_map(
    fn($tok) => ['public_hash' => $block->getTokenPublicHash($tok), 'label' => $block->getTokenLabel($tok)],
    $validVaultTokens
));
$initialVaultTokensJson = json_encode(
        $initialVaultTokens,
        JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
);
?>
<div style="display:none;"><?= $block->getBlockHtml('formkey') ?></div>

<div class="search-pagination-container" style="padding:16px;">
    <div class="filter-wrapper" style="display:flex; gap:12px; align-items:center; margin-bottom:12px;">
        <div class="filter-item">
            <input type="text" id="searchInput"
                   placeholder="<?= $block->escapeHtml(__('Search by order, amount, interval, sequence, status')) ?>" />
        </div>

        <div class="actionContainer" style="display:flex; align-items:center; gap:12px; margin-left:auto;">
            <div class="paginationContainerTop" style="display:flex; align-items:center; gap:8px;">
                <label for="rowsPerPage"><?= $block->escapeHtml(__('Limit:')) ?></label>
                <select id="rowsPerPage" style="margin-left:4px;">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20" selected>20</option>
                </select>
            </div>
        </div>
    </div>

    <?php if (empty($rows)): ?>
        <p><?= $block->escapeHtml(__('No prior recurring payments were found on your account.')) ?></p>
    <?php else: ?>
        <table id="recurringTable" class="data-table" style="width:100%; border-collapse:collapse;">
            <thead>
            <tr>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Order')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Date')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Amount')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Interval')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Status')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Payment method')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Next Billing')) ?></th>
                <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;"><?= $block->escapeHtml(__('Cancel subscription')) ?></th>
            </tr>
            </thead>
            <tbody id="tableBody">
            <?php foreach ($rows as $row):
                $sub = $row['subscription'];
                $order = $row['order'];

                $inc = (string)($sub->getOrderIncrementId() ?? '');
                // NEW: determine parent vs child by increment id suffix
                $isChildOrder = ($inc !== '' && preg_match('/-\d+$/', $inc));
                $isParentOrder = !$isChildOrder;

                $date = $order ? $order->getCreatedAt() : ($sub->getCreatedAt() ?: null);
                $amount = $order ? (float)$order->getGrandTotal() : null;

                $intervalValue = (string)($sub->getIntervalValue() ?? '');
                $intervalUnit = (string)($sub->getIntervalUnit() ?? '');
                $interval = trim(($intervalValue !== '' ? $intervalValue : '') . ' ' . ($intervalUnit !== '' ? $intervalUnit : ''));

                $status = (string)($sub->getStatus() ?? '');
                $statusLower = strtolower($status);

                $nextBilling = (string)($sub->getNextBillingDatetime() ?? '');
                $sequence = (string)($sub->getSequence() ?? '');
                $originalInc = (string)($sub->getOriginalOrderIncrement() ?? '');

                $orderUrl = ($order && $order->getEntityId())
                        ? $block->getUrl('sales/order/view', ['order_id' => $order->getEntityId()])
                        : '';

                $subId = (int)($sub->getEntityId() ?: 0);

                $latestSubId  = (int)$block->getLatestSubscriptionIdByChain($sub);
                $isLatestRow  = ($latestSubId > 0 && $subId === $latestSubId);
                $chainCancelled = (bool)$block->getChainCancelledForSubscription($sub);

                // Display status — business rule lives in the Block, not the template.
                $statusLower = $block->getDisplayStatus($sub, $isLatestRow, $isParentOrder, $chainCancelled);

                $headHash      = (string)$block->getHeadPublicHashForSubscription($sub);

                // Card label — token parsing logic lives in the Block, not the template.
                $currentCardLabel = $block->getCardLabel($sub, $order);
                ?>
                <tr class="recurring-row"
                    data-subscription-id="<?= (int)$subId ?>"
                    data-order-inc="<?= $block->escapeHtmlAttr($inc) ?>"
                    data-root="<?= $block->escapeHtmlAttr($originalInc !== '' ? $originalInc : preg_replace('/-\d+$/', '', $inc)) ?>"
                    data-head-hash="<?= $block->escapeHtmlAttr($headHash) ?>">
                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?php if ($orderUrl): ?>
                            <a href="<?= $block->escapeUrl($orderUrl) ?>"><?= $block->escapeHtml($inc ?: __('-')) ?></a>
                        <?php else: ?>
                            <?= $block->escapeHtml($inc ?: __('-')) ?>
                        <?php endif; ?>
                    </td>

                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?= $date ? $block->escapeHtml($date) : $block->escapeHtml(__('Unknown')) ?>
                    </td>

                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?= $amount !== null ? $block->escapeHtml($block->formatPrice((float)$amount)) : $block->escapeHtml(__('N/A')) ?>
                    </td>

                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?= $block->escapeHtml($interval !== '' ? $interval : __('N/A')) ?>
                    </td>

                    <!-- Status -->
                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?php if ($statusLower === 'processed'): ?>
                            <span class="subscription-status-label" style="color:#28a745; font-weight:bold;"><?= $block->escapeHtml(__('Processed')) ?></span>
                        <?php elseif ($statusLower === 'cancelled'): ?>
                            <span class="subscription-status-label" style="color:#c00;"><?= $block->escapeHtml(__('Canceled')) ?></span>
                        <?php elseif ($statusLower === 'active' && $subId > 0 && !$isParentOrder): ?>
                            <select class="subscription-status-select"
                                    data-subscription-id="<?= (int)$subId ?>"
                                    aria-label="<?= $block->escapeHtmlAttr(__('Subscription status for %1', $inc)) ?>">
                                <option value="active" selected><?= $block->escapeHtml(__('Active')) ?></option>
                                <option value="cancelled"><?= $block->escapeHtml(__('Cancel')) ?></option>
                            </select>
                        <?php else: ?>
                            <span class="subscription-status-label"><?= $block->escapeHtml(ucfirst($statusLower ?: 'N/A')) ?></span>
                        <?php endif; ?>
                    </td>

                    <!-- Payment method + Update card -->
                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?php if ($statusLower === 'active' && $subId > 0): ?>
                            <?php if (!empty($validVaultTokens)): ?>
                                <div class="subscription-payment-wrapper"
                                     style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;"
                                     data-subscription-id="<?= (int)$subId ?>">

                                    <span class="subscription-payment-current"
                                          data-subscription-id="<?= (int)$subId ?>"
                                          style="font-size:12px; color:#333;">
                                        <?= $block->escapeHtml(__('Card used: %1', $currentCardLabel ?: __('Saved card'))) ?>
                                    </span>

                                    <button type="button"
                                            class="subscription-update-btn action primary"
                                            data-subscription-id="<?= (int)$subId ?>">
                                        <?= $block->escapeHtml(__('Update card')) ?>
                                    </button>

                                    <div class="subscription-payment-editor"
                                         data-subscription-id="<?= (int)$subId ?>"
                                         style="display:none; gap:8px; align-items:center; flex-wrap:wrap;">

                                        <select class="subscription-payment-select"
                                                data-subscription-id="<?= (int)$subId ?>"
                                                data-vault-loaded="true"
                                                aria-label="<?= $block->escapeHtmlAttr(__('Select payment method for subscription %1', $inc)) ?>">
                                            <option value=""><?= $block->escapeHtml(__('Select a saved card')) ?></option>
                                            <?php foreach ($validVaultTokens as $tok):
                                                $ph = $block->getTokenPublicHash($tok);
                                                if ($ph === '') continue;
                                                ?>
                                                <option value="<?= $block->escapeHtmlAttr($ph) ?>">
                                                    <?= $block->escapeHtml($block->getTokenLabel($tok)) ?>
                                                </option>
                                            <?php endforeach; ?>
                                        </select>

                                        <button type="button"
                                                class="subscription-save-btn action secondary"
                                                data-subscription-id="<?= (int)$subId ?>">
                                            <?= $block->escapeHtml(__('Save')) ?>
                                        </button>

                                        <button type="button"
                                                class="subscription-cancel-edit-btn action secondary"
                                                data-subscription-id="<?= (int)$subId ?>">
                                            <?= $block->escapeHtml(__('Cancel')) ?>
                                        </button>
                                    </div>

                                    <span class="subscription-update-feedback"
                                          data-subscription-id="<?= (int)$subId ?>"
                                          <?php
                                          $headSub = $block->getHeadSubscriptionForSubscription($sub);
                                          $changePaymentCard = ($headSub && method_exists($headSub, 'getChangePaymentCard'))
                                              ? (string)($headSub->getChangePaymentCard() ?? '')
                                              : '';
                                          echo $changePaymentCard !== '' ? ' color:#0a7a0a;' : '';
                                          ?>
                                        <?php if ($changePaymentCard !== ''): ?>
                                            <?= $block->escapeHtml(__('Updated. Future renewals will use this card.')) ?>
                                            <?= $block->escapeHtml(__('Card number: %1', $changePaymentCard)) ?>
                                        <?php endif; ?>
                                    </span>
                                </div>
                            <?php else: ?>
                                <span style="font-size:12px; color:#333;">
                                    <?= $currentCardLabel !== '' ? $block->escapeHtml(__('Card used: %1', $currentCardLabel)) : $block->escapeHtml(__('No saved cards found.')) ?>
                                </span>
                            <?php endif; ?>
                        <?php else: ?>
                            <span style="font-size:12px; color:#333;">
                                <?= $currentCardLabel !== '' ? $block->escapeHtml(__('Card used: %1', $currentCardLabel)) : $block->escapeHtml(__('—')) ?>
                            </span>
                        <?php endif; ?>
                    </td>

                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?php
                        if ($isParentOrder) {
                            $displayNextBilling = $block->getFirstNextBillingForHead($sub);
                            if ($displayNextBilling === '') {
                                $displayNextBilling = $nextBilling;
                            }
                        } else {
                            $displayNextBilling = $nextBilling;
                        }
                        ?>
                        <?= $displayNextBilling !== '' ? $block->escapeHtml($displayNextBilling . ' UTC') : $block->escapeHtml(__('N/A')) ?>
                    </td>

                    <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                        <?php
                        $rootSubId = (int)$block->getHeadSubscriptionIdForSubscription($sub);
                        if ($rootSubId <= 0) { $rootSubId = (int)$subId; }
                        ?>
                        <?php if ($chainCancelled): ?>
                            <span style="color:#c00; font-size:12px; font-weight:bold;"><?= $block->escapeHtml(__('Subscription canceled')) ?></span>
                        <?php elseif ($rootSubId > 0): ?>
                            <button type="button"
                                    class="subscription-cancel-chain-btn action secondary"
                                    data-root-subscription-id="<?= (int)$rootSubId ?>">
                                <?= $block->escapeHtml(__('Cancel subscription')) ?>
                            </button>
                        <?php else: ?>
                            <span style="color:#777; font-size:12px;"><?= $block->escapeHtml(__('—')) ?></span>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>

        <div id="noRecordsMessage" style="display:none; margin-top:12px;">
            <?= $block->escapeHtml(__('No prior recurring payments were found on your account.')) ?>
        </div>

        <div id="paginationControls" style="margin-top:12px;" data-total="<?= (int)count($rows) ?>"></div>
    <?php endif; ?>
</div>

<script type="text/x-magento-init">
    {
      "*": {
        "Fiserv_Payments/js/subscription/recurring": {
          "cancelUrl": "<?= $block->escapeJs($block->getUrl('fiserv/subscription/cancel')) ?>",
      "updateUrl": "<?= $block->escapeJs($block->getUrl('fiserv/subscription/updatePayment')) ?>",
      "dataUrl": "<?= $block->escapeJs($block->getUrl('fiserv/subscription/recurringData')) ?>",
      "orderViewBaseUrl": "<?= $block->escapeJs($block->getUrl('sales/order/view', ['order_id' => 'ORDER_ID_PLACEHOLDER'])) ?>",
      "vaultListUrl": "<?= $block->escapeJs($vaultListUrl) ?>",
      "initialVaultTokens": <?= $initialVaultTokensJson ?: '[]' ?>,
      "searchInputId": "searchInput",
      "rowsPerPageId": "rowsPerPage",
      "tableBodyId": "tableBody",
      "noRecordsId": "noRecordsMessage",
      "paginationId": "paginationControls",
      "msgSelectCard": "<?= $block->escapeJs(__('Please select a saved card.')) ?>",
      "msgSaving": "<?= $block->escapeJs(__('Saving...')) ?>",
      "msgUpdated": "<?= $block->escapeJs(__('Updated. Future renewals will use this card.')) ?>",
      "msgConfirmCancelLatest": "<?= $block->escapeJs(__('Cancel the latest renewal transaction? Recurring will continue.')) ?>",
      "msgCancelling": "<?= $block->escapeJs(__('Cancelling...')) ?>",
      "msgCancelFailedPrefix": "<?= $block->escapeJs(__('Failed to cancel:')) ?> ",
      "msgConfirmCancelChain": "<?= $block->escapeJs(__('Cancel this subscription? Future renewals will stop.')) ?>",
      "msgCancelFailedPrefix2": "<?= $block->escapeJs(__('Failed to cancel subscription:')) ?> "
    }
  }
}
</script>