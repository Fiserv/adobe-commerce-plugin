<?php return; endif; ?>

<?php
/* Use block-provided label/public_hash (array-first). Falls back to object getters if necessary. */
$tokenLabel = function ($token) {
    if (is_array($token) && !empty($token['label'])) {
        return (string)$token['label'];
    }
    if (is_object($token) && method_exists($token, 'getLabel')) {
        return (string)$token->getLabel();
    }
    return (string)__('Saved card');
};

$getPublicHash = function ($token) {
    if (is_array($token) && !empty($token['public_hash'])) {
        return (string)$token['public_hash'];
    }
    if (is_object($token) && method_exists($token, 'getPublicHash')) {
        return (string)$token->getPublicHash();
    }
    return '';
};

$validVaultTokens = [];
foreach ($vaultTokens as $tok) {
    $ph = $getPublicHash($tok);
    if ($ph !== '') {
        $validVaultTokens[] = $tok;
    }
}

// Build inline snapshot for JS (array of {public_hash,label})
$initialVaultTokens = [];
foreach ($validVaultTokens as $tok) {
    $ph = $getPublicHash($tok);
    if ($ph === '') continue;
    $initialVaultTokens[] = ['public_hash' => $ph, 'label' => $tokenLabel($tok)];
}
$initialVaultTokensJson = json_encode(
        $initialVaultTokens,
        JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
);
?>
<div style="display:none;"><?= $block->getBlockHtml('formkey') ?></div>

<div class="search-pagination-container" style="padding:16px;">
    <div class="filter-wrapper" style="display:flex; gap:12px; align-items:center; margin-bottom:12px;">
        <div class="filter-item">
            <input type="text" id="searchInput"
                   placeholder="<?= $block->escapeHtml(__('Search by order, amount, interval, sequence, status')) ?>" />
