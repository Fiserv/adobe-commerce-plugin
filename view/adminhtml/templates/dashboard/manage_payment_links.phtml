<?php
/**
 * @var $block \Fiserv\Payments\Block\Adminhtml\Paybylink\Manage
 *
 * Interaction UX driven by AJAX requests back to Controller/Adminhtml/Paybylink/Index.php instead of full page reloads.
 */
$filters = $block->getFilterParams();
$totalPages = $block->getTotalPages();
?>
<div class="block">
    <div class="block-title"><strong><?= $block->escapeHtml(__('Manage Payment Links')) ?></strong></div>
    <div class="block-content">
        <div class="message message-notice">
            <div><?= $block->escapeHtml(__('Link status is not updated in real time. Reload the page to refresh.')) ?></div>
        </div>

        <div class="search-pagination-container">
            <div class="filter-wrapper">
                <div class="filter-item">
                    <input type="text" id="searchInput" placeholder="<?= $block->escapeHtmlAttr(__('Search via Order Number')) ?>" value="<?= $block->escapeHtmlAttr($filters['search']) ?>">
                </div>
                <div class="actionContainer">
                    <button type="button" id="toggleFilterBtn"><?= $block->escapeHtml(__('Filter')) ?></button>

                    <div class="paginationContainerTop" style="margin-left: auto; display: flex; align-items: center;">
                        <label for="rowsPerPage"><?= $block->escapeHtml(__('Limit:')) ?></label>
                        <select id="rowsPerPage" style="margin: 0 0.5rem;">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20" selected="">20</option>
                        </select>
                        <span id="paginationInfoTop" class="pagination-info">1 <?= $block->escapeHtml(__('of')) ?> <?= $block->escapeHtml($totalPages) ?></span>
                    </div>
                </div>
            </div>

            <!-- Animated Filter Section (same #filterSection.open pattern as Declines/Preview) -->
            <div id="filterSection">
                <div class="filter-item">
                    <label for="filter_status"><?= $block->escapeHtml(__('Status:')) ?></label>
                    <select id="filter_status">
                        <option value=""><?= $block->escapeHtml(__('All')) ?></option>
                        <option value="unpaid" <?= $filters['status'] === 'unpaid' ? 'selected' : '' ?>><?= $block->escapeHtml(__('Unpaid')) ?></option>
                        <option value="paid" <?= $filters['status'] === 'paid' ? 'selected' : '' ?>><?= $block->escapeHtml(__('Paid')) ?></option>
                        <option value="expired" <?= $filters['status'] === 'expired' ? 'selected' : '' ?>><?= $block->escapeHtml(__('Expired')) ?></option>
                    </select>
                </div>
                <div class="filter-item">
                    <label for="filter_amount_from"><?= $block->escapeHtml(__('Amount:')) ?></label>
                    <input type="number" step="0.01" id="filter_amount_from" value="<?= $block->escapeHtmlAttr($filters['amount_from']) ?>" placeholder="<?= $block->escapeHtmlAttr(__('From')) ?>">
                    <input type="number" step="0.01" id="filter_amount_to" value="<?= $block->escapeHtmlAttr($filters['amount_to']) ?>" placeholder="<?= $block->escapeHtmlAttr(__('To')) ?>">
                </div>
                <div class="filter-item">
                    <label for="filter_created_from"><?= $block->escapeHtml(__('Created:')) ?></label>
                    <input type="date" id="filter_created_from" value="<?= $block->escapeHtmlAttr($filters['created_from']) ?>">
                    <input type="date" id="filter_created_to" value="<?= $block->escapeHtmlAttr($filters['created_to']) ?>">
                </div>
                <div class="filter-item">
                    <label for="filter_expires_from"><?= $block->escapeHtml(__('Expires:')) ?></label>
                    <input type="date" id="filter_expires_from" value="<?= $block->escapeHtmlAttr($filters['expires_from']) ?>">
                    <input type="date" id="filter_expires_to" value="<?= $block->escapeHtmlAttr($filters['expires_to']) ?>">
                </div>
                <button id="resetFilter" type="button" style="font-size: 1rem; background-color: #f1f1f1; padding: 5px 15px; display: none;"><?= $block->escapeHtml(__('RESET')) ?></button>
            </div>
        </div>

        <div class="admin__table-wrapper">
            <table id="transactionsTable" class="data-table admin__table-primary">
                <thead>
                    <tr>
                        <th class="data-grid-th"><span><?= $block->escapeHtml(__('Order Number')) ?></span></th>
                        <th class="data-grid-th"><span><?= $block->escapeHtml(__('Payment Amount')) ?></span></th>
                        <th class="data-grid-th"><span><?= $block->escapeHtml(__('Link Creation Date')) ?></span></th>
                        <th class="data-grid-th"><span><?= $block->escapeHtml(__('Link Expiration')) ?></span></th>
                        <th class="data-grid-th"><span><?= $block->escapeHtml(__('Status')) ?></span></th>
                        <th class="data-grid-th"><span><?= $block->escapeHtml(__('Actions')) ?></span></th>
                    </tr>
                </thead>
                <tbody id="tableBody">
            <?php $rows = $block->getRows(); ?>
                <?php if ($rows): ?>
                    <?php foreach ($rows as $row): ?>
                        <tr>
                            <?php if (!empty($row['entity_id'])): ?>
                                <?php $orderUrl = $block->getUrl('sales/order/view', ['order_id' => $row['entity_id']]); ?>
                                <td><a href="<?= $block->escapeHtmlAttr($orderUrl) ?>"><?= $block->escapeHtml($row['order']) ?></a></td>
                            <?php else: ?>
                                <td><?= $block->escapeHtml($row['order']) ?></td>
                            <?php endif; ?>
                            <td><?= $block->escapeHtml($row['amount_formatted'] ?? $row['amount']) ?></td>
                            <td>
                                <?php
                                    $createdTs = isset($row['created_ts']) && $row['created_ts'] ? (int)$row['created_ts'] : false;
                                    if (!$createdTs) {
                                        $createdSrc = $row['created'] ?? ($row['created_formatted'] ?? '');
                                        $createdTs = $createdSrc ? @strtotime($createdSrc) : false;
                                    }
                                    if ($createdTs) {
                                        $createdDate = date('n/j/y', $createdTs);
                                        $createdTime = date('g:ia', $createdTs);
                                    } else {
                                        $createdDate = $row['created'] ?? '';
                                        $createdTime = '';
                                    }
                                ?>
                                <div class="date-wrap">
                                    <div class="date-main"><?= $block->escapeHtml($createdDate) ?></div>
                                    <?php if ($createdTime): ?>
                                        <div class="date-time"><?= $block->escapeHtml($createdTime) ?></div>
                                    <?php endif; ?>
                                </div>
                            </td>
                            <td>
                                <?php
                                    $expiresTs = isset($row['expires_ts']) && $row['expires_ts'] ? (int)$row['expires_ts'] : false;
                                    if (!$expiresTs) {
                                        $expiresSrc = $row['expires_raw'] ?? ($row['expires'] ?? '');
                                        $expiresTs = $expiresSrc ? @strtotime($expiresSrc) : false;
                                    }
                                    if ($expiresTs) {
                                        $expiresDate = date('n/j/y', $expiresTs);
                                        $expiresTime = date('g:ia', $expiresTs);
                                    } else {
                                        $expiresDate = $row['expires'] ?? '';
                                        $expiresTime = '';
                                    }
                                ?>
                                <div class="date-wrap">
                                    <div class="date-main"><?= $block->escapeHtml($expiresDate) ?></div>
                                    <?php if (!empty($expiresTime)): ?>
                                        <div class="date-time"><?= $block->escapeHtml($expiresTime) ?></div>
                                    <?php endif; ?>
                                </div>
                            </td>
                            <td>
                                <?php
                                    $status = strtolower((string)($row['status_code'] ?? $row['status']));
                                    if ($status === 'expired') {
                                        echo '<span class="status-expired">' . $block->escapeHtml(ucfirst($status)) . '</span>';
                                    } else {
                                        echo $block->escapeHtml(ucfirst($status));
                                    }
                                ?>
                            </td>
                            <td class="actions-cell">
                                <?php
                                    $statusCode = strtolower((string)($row['status_code'] ?? $row['status'] ?? ''));
                                    $retryUrl = isset($row['retry_url']) ? $row['retry_url'] : (isset($row['action_url']) ? $row['action_url'] : '');
                                    $orderLabel = $row['order'] ?? '';
                                    $paybylinkUrl = isset($row['paybylink_url']) && $row['paybylink_url'] ? $row['paybylink_url'] : '';
                                    $copyText = $paybylinkUrl ?: $orderLabel;
                                    $entityId = $row['entity_id'] ?? '';
                                    $viewOrderUrl = $block->getUrl('sales/order/view', ['order_id' => $entityId]);
                                ?>
                                <div class="action-icons" style="display:flex;gap:8px;align-items:center;">
                                    <?php if ($statusCode === 'unpaid'): ?>

                                        <!-- Copy Link Button -->
                                        <button type="button" class="copy-link-btn" data-link="<?= $block->escapeHtmlAttr($copyText) ?>" onclick="openCopyModal(this)" title="<?= $block->escapeHtmlAttr(__('Copy Link')) ?>">
                                            <img src="<?= $block->escapeHtmlAttr($block->getViewFileUrl('Fiserv_Payments::images/icon-copy.svg')) ?>" alt="<?= $block->escapeHtmlAttr(__('Copy Link')) ?>" width="16" height="16" />
                                        </button>

                                        <!-- View Order -->
                                        <a href="<?= $block->escapeHtmlAttr($viewOrderUrl) ?>" title="<?= $block->escapeHtmlAttr(__('View Order')) ?>" class="action-view-order" style="display:inline-flex;align-items:center;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>

                                    <?php elseif ($statusCode === 'expired'): ?>
                                        <!-- Refresh / Retry (state change must be POST) -->
                                        <?php if ($retryUrl): ?>
                                            <form action="<?= $block->escapeHtmlAttr($retryUrl) ?>" method="post" style="display:inline-flex;align-items:center;margin:0;">
                                                <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>" />
                                                <button type="submit" title="<?= $block->escapeHtmlAttr(__('Refresh Payment Link')) ?>" class="action-retry" style="display:inline-flex;align-items:center;background:none;border:none;padding:0;cursor:pointer;">
                                                    <img src="<?= $block->escapeHtmlAttr($block->getViewFileUrl('Fiserv_Payments::images/icon-retry.svg')) ?>" alt="<?= $block->escapeHtmlAttr(__('Refresh Payment Link')) ?>" width="16" height="16" />
                                                </button>
                                            </form>
                                        <?php else: ?>
                                            <span class="action-retry disabled" title="<?= $block->escapeHtmlAttr(__('Refresh Payment Link')) ?>">
                                                <img src="<?= $block->escapeHtmlAttr($block->getViewFileUrl('Fiserv_Payments::images/icon-retry.svg')) ?>" alt="<?= $block->escapeHtmlAttr(__('Refresh Payment Link')) ?>" width="16" height="16" />
                                            </span>
                                        <?php endif; ?>

                                        <!-- View Order -->
                                        <a href="<?= $block->escapeHtmlAttr($viewOrderUrl) ?>" title="<?= $block->escapeHtmlAttr(__('View Order')) ?>" class="action-view-order" style="display:inline-flex;align-items:center;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>

                                    <?php elseif ($statusCode === 'paid'): ?>
                                        <!-- View Order only for paid -->
                                        <a href="<?= $block->escapeHtmlAttr($viewOrderUrl) ?>" title="<?= $block->escapeHtmlAttr(__('View Order')) ?>" class="action-view-order" style="display:inline-flex;align-items:center;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                    <?php endif; ?>
                                </div>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
                </tbody>
            </table>
        </div>

        <div id="noRecordsMessage" style="<?= $rows ? 'display: none;' : '' ?>margin-bottom: 20%;"><?= $block->escapeHtml(__('No records found.')) ?></div>

        <div id="paginationControls" data-totalPage="<?= $block->escapeHtmlAttr($totalPages) ?>"></div>
    </div>
</div>

<!-- Copy Link Modal -->
<div id="copy-link-modal" style="display:none;">
    <div class="modal-inner-content">
        <button type="button" class="modal-close-btn" onclick="closeCopyModal()">×</button>
        <div class="modal-success" id="modal-success">
            <?= $block->escapeHtml(__('Link is copied to Clipboard')) ?>
            <img src="<?= $block->escapeHtmlAttr($block->getViewFileUrl('Fiserv_Payments::images/icon-success.svg')) ?>" alt="" width="24" height="24" />
        </div>
        <div class="modal-link-row">
            <div class="modal-link-box" id="modal-link-text"></div>
            <button type="button" class="modal-btn-copy" id="modal-copy-btn" onclick="copyModalLink()"><?= $block->escapeHtml(__('Copy Link')) ?></button>
        </div>
    </div>
</div>

